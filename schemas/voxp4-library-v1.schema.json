{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VoxP4PortableLibraryV1",
  "description": "Public data contract for VoxP4 Portable Library Format Version 1",
  "type": "object",
  "required": ["format", "formatVersion", "libraryId", "name"],
  "properties": {
    "format": {
      "type": "string",
      "enum": ["voxp4-library"]
    },
    "formatVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "libraryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "presets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "type": ["boolean", "number", "string"]
            }
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "basePresetId": { "type": "string", "maxLength": 64 },
          "metadata": {
            "type": "object",
            "properties": {
              "artist": { "type": "string", "maxLength": 64 },
              "notes": { "type": "string", "maxLength": 256 },
              "tags": { "type": "string", "maxLength": 128 }
            },
            "additionalProperties": true
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "type": ["boolean", "number", "string"]
            }
          },
          "subscenes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 64 },
                "name": { "type": "string", "minLength": 1, "maxLength": 64 },
                "parameters": {
                  "type": "object",
                  "additionalProperties": {
                    "type": ["boolean", "number", "string"]
                  }
                }
              }
            }
          }
        }
      }
    },
    "setlists": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "entries"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "sceneId"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 64 },
                "sceneId": { "type": "string", "minLength": 1, "maxLength": 64 }
              }
            }
          }
        }
      }
    }
  }
}
